# Copy this file to .env and fill in your own Supabase project values.
# Find both under Project Settings -> API in your Supabase dashboard.
# The anon key is safe to expose in frontend code -- it only grants
# whatever the Row Level Security policies allow (see supabase/schema.sql).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
